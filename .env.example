# 4me (Xurrent) REST API
FOURME_API_URL=https://api.4me.com/v1/requests
FOURME_API_TOKEN=your-personal-access-token
FOURME_ACCOUNT=your-account-id
# X-4me-Account on older installations
FOURME_ACCOUNT_HEADER=X-Xurrent-Account
FOURME_VERIFY_SSL=true
# Concurrent request creations per process (keeps the integration under the rate limit)
FOURME_MAX_CONCURRENT=2
FOURME_AUDIT_DB=/var/lib/itsm-4me/audit.sqlite3
FOURME_ROUTING_RULES=routing_rules.json

# Escalation content
QRADAR_CONSOLE=qradar.example.com
ESCALATION_RULE_ARTIFACT_TYPE=QRadar Rule
ESCALATION_LOG_SOURCE_ARTIFACT_TYPE=QRadar Log Source
# Incidents whose name contains this text are treated as credential-leak alerts
ESCALATION_LEAK_INCIDENT_PATTERN=IdentityAPI

# Mail (failure alerts and the daily report)
SMTP_HOST=smtp.example.com
SMTP_PORT=25
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=soar-integrations@example.com
ALERT_MAIL_TO=soc-engineering@example.com
ALERT_MAIL_CC=
REPORT_MAIL_TO=soc-engineering@example.com
REPORT_MAIL_CC=
